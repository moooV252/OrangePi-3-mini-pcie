From 8be8713a9cf296c53459021b8c06d679eb097ebf Mon Sep 17 00:00:00 2001
From: Orange Pi 3 port <port@localhost>
Date: Sun, 23 Aug 2026 12:53:24 +0900
Subject: [PATCH 7/8] r8169: add missed-MSI TX-completion polling fallback for
 RTL8168F

---
 drivers/net/ethernet/realtek/r8169_main.c | 267 +++++++++++++++++++++-
 1 file changed, 256 insertions(+), 11 deletions(-)

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index 7db0aceb8123..345ca31bcd53 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -22,6 +22,7 @@
 #include <linux/io.h>
 #include <linux/ip.h>
 #include <linux/tcp.h>
+#include <linux/hrtimer.h>
 #include <linux/interrupt.h>
 #include <linux/dma-mapping.h>
 #include <linux/pm_runtime.h>
@@ -71,6 +72,17 @@
 #define NUM_RX_DESC	256	/* Number of Rx descriptor registers */
 #define R8169_TX_RING_BYTES	(NUM_TX_DESC * sizeof(struct TxDesc))
 #define R8169_RX_RING_BYTES	(NUM_RX_DESC * sizeof(struct RxDesc))
+
+static unsigned int opi3_poll_ms = 1;
+module_param_named(poll_ms, opi3_poll_ms, uint, 0444);
+MODULE_PARM_DESC(poll_ms, "missed-MSI fallback poll interval ms (default 1)");
+#define RTL8169_MISSED_MSI_POLL_MS	 opi3_poll_ms
+#define RTL8169_MISSED_MSI_CREDIT_MS	100
+
+static bool opi3_timer_only = false;
+module_param_named(timer_only, opi3_timer_only, bool, 0444);
+MODULE_PARM_DESC(timer_only,
+	"Enable vendor timer-only moderation for RTL8168F (default off)");
 #define R8169_TX_STOP_THRS	(MAX_SKB_FRAGS + 1)
 #define R8169_TX_START_THRS	(2 * R8169_TX_STOP_THRS)
 
@@ -712,6 +724,14 @@ struct rtl8169_private {
 	dma_addr_t RxPhyAddr;
 	struct page *Rx_databuff[NUM_RX_DESC];	/* Rx data buffers */
 	dma_addr_t Rx_dma[NUM_RX_DESC];	/* Stable DMA addresses for Rx data */
+	unsigned long missed_msi_flags;
+	struct delayed_work missed_msi_work;
+	struct hrtimer missed_msi_timer;
+	u32 missed_msi_polls;
+	u32 missed_msi_hits;
+	u32 missed_msi_first_status;
+	u32 missed_msi_credit_irqs;
+	unsigned long missed_msi_credit_deadline;
 	struct ring_info tx_skb[NUM_TX_DESC];	/* Tx data buffers */
 	u16 cp_cmd;
 	u16 tx_lpi_timer;
@@ -743,6 +763,17 @@ struct rtl8169_private {
 	u32 ocp_base;
 };
 
+enum rtl_missed_msi_flag {
+	RTL_MISSED_MSI_ENABLED = 0,
+	RTL_MISSED_MSI_PM_HELD,
+	RTL_MISSED_MSI_DEAD,
+	RTL_MISSED_MSI_FIRST_HIT_LOGGED,
+	RTL_MISSED_MSI_SUMMARY_LOGGED,
+	RTL_MISSED_MSI_ACK_CREDIT,
+};
+
+static void rtl8169_missed_msi_fault_stop(struct rtl8169_private *tp);
+
 typedef void (*rtl_generic_fct)(struct rtl8169_private *tp);
 
 MODULE_AUTHOR("Realtek and the Linux r8169 crew <netdev@vger.kernel.org>");
@@ -3905,8 +3936,9 @@ static void rtl_hw_start_8168(struct rtl8169_private *tp)
 	rtl_hw_config(tp);
 
 	tp->cp_cmd &= ~INTT_MASK;
-	if (tp->mac_version == RTL_GIGA_MAC_VER_35 ||
-	    tp->mac_version == RTL_GIGA_MAC_VER_36) {
+	if (opi3_timer_only &&
+	    (tp->mac_version == RTL_GIGA_MAC_VER_35 ||
+	     tp->mac_version == RTL_GIGA_MAC_VER_36)) {
 		/* Vendor 3.10 timer-only moderation setup for RTL8168F. */
 		tp->cp_cmd |= PktCntrDisable | 1;
 		intr_mitigate = 0x5151;
@@ -4633,6 +4665,7 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 			netdev_err(dev,
 				   "Rx descriptor %u DMA address was overwritten; stopping DMA\n",
 				   entry);
+			rtl8169_missed_msi_fault_stop(tp);
 			RTL_W8(tp, ChipCmd, RTL_R8(tp, ChipCmd) &
 					       ~(CmdTxEnb | CmdRxEnb));
 			netif_stop_queue(dev);
@@ -4705,19 +4738,27 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 	return count;
 }
 
-static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
+static bool rtl8169_missed_msi_supported(struct rtl8169_private *tp)
 {
-	struct rtl8169_private *tp = dev_instance;
-	u32 status = rtl_get_events(tp);
+	return tp->mac_version == RTL_GIGA_MAC_VER_35 ||
+	       tp->mac_version == RTL_GIGA_MAC_VER_36;
+}
 
+/*
+ * Shared event handling for the real MSI handler and the missed-MSI polling
+ * fallback. Returns true when the status belonged to us and was handled.
+ */
+static bool rtl8169_handle_events(struct rtl8169_private *tp, u32 status)
+{
 	if ((status & 0xffff) == 0xffff || !(status & tp->irq_mask))
-		return IRQ_NONE;
+		return false;
 
 	/* At least RTL8168fp may unexpectedly set the SYSErr bit */
 	if (unlikely(status & SYSErr &&
 	    tp->mac_version <= RTL_GIGA_MAC_VER_06)) {
 		rtl8169_pcierr_interrupt(tp->dev);
-		goto out;
+		rtl_ack_events(tp, status);
+		return true;
 	}
 
 	if (status & LinkChg)
@@ -4725,10 +4766,208 @@ static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
 
 	rtl_irq_disable(tp);
 	napi_schedule(&tp->napi);
-out:
+
 	rtl_ack_events(tp, status);
 
-	return IRQ_HANDLED;
+	return true;
+}
+
+static irqreturn_t rtl8169_interrupt_common(struct rtl8169_private *tp,
+					     bool consume_credit)
+{
+	u32 status = rtl_get_events(tp);
+	bool credit = false;
+
+	if (consume_credit) {
+		credit = test_and_clear_bit(RTL_MISSED_MSI_ACK_CREDIT,
+					    &tp->missed_msi_flags);
+		if (credit)
+			smp_mb__after_atomic();
+	}
+
+	if (rtl8169_handle_events(tp, status))
+		return IRQ_HANDLED;
+
+	/*
+	 * A real MSI that arrived right after the fallback already serviced the
+	 * events surfaces here as status == 0. Within a bounded window after a
+	 * fallback hit, treat exactly one such MSI as expected, not spurious.
+	 */
+	if (credit && status == 0 && rtl8169_missed_msi_supported(tp) &&
+	    tp->pci_dev->msi_enabled && !tp->pci_dev->msix_enabled &&
+	    test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags) &&
+	    !test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) &&
+	    time_before_eq(jiffies, READ_ONCE(tp->missed_msi_credit_deadline))) {
+		if (tp->missed_msi_credit_irqs != ~0U)
+			tp->missed_msi_credit_irqs++;
+		return IRQ_HANDLED;
+	}
+
+	return IRQ_NONE;
+}
+
+static enum hrtimer_restart rtl8169_missed_msi_hrtimer(struct hrtimer *timer)
+{
+	struct rtl8169_private *tp =
+		container_of(timer, struct rtl8169_private, missed_msi_timer);
+
+	queue_delayed_work(system_wq, &tp->missed_msi_work, 0);
+	return HRTIMER_NORESTART;
+}
+
+static void rtl8169_missed_msi_rearm(struct rtl8169_private *tp, u64 ns)
+{
+	hrtimer_start_range_ns(&tp->missed_msi_timer, ns_to_ktime(ns),
+			       100000, HRTIMER_MODE_REL_SOFT);
+}
+
+static void rtl8169_missed_msi_pm_put(struct rtl8169_private *tp)
+{
+	if (test_and_clear_bit(RTL_MISSED_MSI_PM_HELD, &tp->missed_msi_flags))
+		pm_runtime_put_noidle(&tp->pci_dev->dev);
+}
+
+static bool rtl8169_missed_msi_can_run(struct rtl8169_private *tp)
+{
+	return test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags) &&
+	       !test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) &&
+	       netif_running(tp->dev) &&
+	       tp->pci_dev->msi_enabled && !tp->pci_dev->msix_enabled &&
+	       pm_runtime_active(&tp->pci_dev->dev) &&
+	       tp->TxDescArray && tp->RxDescArray;
+}
+
+static void rtl8169_missed_msi_fault_stop(struct rtl8169_private *tp)
+{
+	set_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	hrtimer_cancel(&tp->missed_msi_timer);
+	cancel_delayed_work(&tp->missed_msi_work);
+	rtl8169_missed_msi_pm_put(tp);
+}
+
+static void rtl8169_missed_msi_work(struct work_struct *work)
+{
+	struct rtl8169_private *tp = container_of(to_delayed_work(work),
+						 struct rtl8169_private,
+						 missed_msi_work);
+	int irq = tp->irq;
+	u32 status = 0;
+	bool first_hit = false;
+	bool rearm;
+
+	if (!test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags))
+		return;
+
+	if (!rtnl_trylock()) {
+		/* Down/up in progress; retry shortly. */
+		rtl8169_missed_msi_rearm(tp, opi3_poll_ms * NSEC_PER_MSEC);
+		return;
+	}
+
+	if (irq >= 0 && rtl8169_missed_msi_can_run(tp)) {
+		/*
+		 * The MMIO status/ack path is shared with the real MSI handler.
+		 * Serialize against it while polling from process context.
+		 */
+		disable_irq(irq);
+
+		if (rtl8169_missed_msi_can_run(tp)) {
+			if (tp->missed_msi_polls != ~0U)
+				tp->missed_msi_polls++;
+			status = rtl_get_events(tp);
+			if (rtl8169_handle_events(tp, status)) {
+				if (!test_and_set_bit(RTL_MISSED_MSI_FIRST_HIT_LOGGED,
+						      &tp->missed_msi_flags)) {
+					tp->missed_msi_first_status = status;
+					first_hit = true;
+				}
+				if (tp->missed_msi_hits != ~0U)
+					tp->missed_msi_hits++;
+				if (rtl8169_missed_msi_can_run(tp)) {
+					WRITE_ONCE(tp->missed_msi_credit_deadline,
+						   jiffies + msecs_to_jiffies(
+						   RTL8169_MISSED_MSI_CREDIT_MS));
+					smp_wmb();
+					set_bit(RTL_MISSED_MSI_ACK_CREDIT,
+						&tp->missed_msi_flags);
+				}
+			}
+		}
+
+		enable_irq(irq);
+	}
+
+	if (first_hit)
+		netdev_warn(tp->dev,
+			    "missed-MSI fallback first hit: status=%08x masked=%08x polls=%u hits=%u irq=%d cur_tx=%u dirty_tx=%u\n",
+			    status, status & tp->irq_mask, tp->missed_msi_polls,
+			    tp->missed_msi_hits, irq, tp->cur_tx, tp->dirty_tx);
+
+	rearm = rtl8169_missed_msi_can_run(tp);
+	if (rearm)
+		rtl8169_missed_msi_rearm(tp, opi3_poll_ms * NSEC_PER_MSEC);
+
+	rtnl_unlock();
+
+	if (!rearm)
+		rtl8169_missed_msi_pm_put(tp);
+}
+
+static void rtl8169_missed_msi_start(struct rtl8169_private *tp)
+{
+	if (!rtl8169_missed_msi_supported(tp) ||
+	    !tp->pci_dev->msi_enabled ||
+	    pm_runtime_active(&tp->pci_dev->dev) != true ||
+	    tp->irq < 0 ||
+	    test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) ||
+	    !tp->TxDescArray || !tp->RxDescArray ||
+	    test_and_set_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags))
+		return;
+
+	clear_bit(RTL_MISSED_MSI_FIRST_HIT_LOGGED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_SUMMARY_LOGGED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	tp->missed_msi_polls = 0;
+	tp->missed_msi_hits = 0;
+	tp->missed_msi_first_status = 0;
+	tp->missed_msi_credit_irqs = 0;
+	tp->missed_msi_credit_deadline = 0;
+	pm_runtime_get_noresume(&tp->pci_dev->dev);
+	set_bit(RTL_MISSED_MSI_PM_HELD, &tp->missed_msi_flags);
+
+	netdev_info(tp->dev,
+		     "missed-MSI fallback armed: period_ms=%u credit_ms=%u irq=%d\n",
+		     RTL8169_MISSED_MSI_POLL_MS, RTL8169_MISSED_MSI_CREDIT_MS,
+		     tp->irq);
+
+	hrtimer_setup(&tp->missed_msi_timer, rtl8169_missed_msi_hrtimer,
+		      CLOCK_MONOTONIC, HRTIMER_MODE_REL_SOFT);
+	rtl8169_missed_msi_rearm(tp, opi3_poll_ms * NSEC_PER_MSEC);
+}
+
+static void rtl8169_missed_msi_stop(struct rtl8169_private *tp)
+{
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	hrtimer_cancel(&tp->missed_msi_timer);
+	cancel_delayed_work_sync(&tp->missed_msi_work);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	rtl8169_missed_msi_pm_put(tp);
+
+	if (tp->missed_msi_hits &&
+	    !test_and_set_bit(RTL_MISSED_MSI_SUMMARY_LOGGED,
+			      &tp->missed_msi_flags))
+		netdev_warn(tp->dev,
+			    "missed-MSI fallback stopped: polls=%u hits=%u credited_irqs=%u first_status=%08x\n",
+			    tp->missed_msi_polls, tp->missed_msi_hits,
+			    tp->missed_msi_credit_irqs,
+			    tp->missed_msi_first_status);
+}
+
+static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
+{
+	return rtl8169_interrupt_common(dev_instance, true);
 }
 
 static void rtl_task(struct work_struct *work)
@@ -4818,6 +5057,7 @@ static int r8169_phy_connect(struct rtl8169_private *tp)
 
 static void rtl8169_down(struct rtl8169_private *tp)
 {
+	rtl8169_missed_msi_stop(tp);
 	disable_work_sync(&tp->wk.work);
 	/* Clear all task flags */
 	bitmap_zero(tp->wk.flags, RTL_FLAG_MAX);
@@ -4849,6 +5089,7 @@ static void rtl8169_up(struct rtl8169_private *tp)
 	napi_enable(&tp->napi);
 	enable_work(&tp->wk.work);
 	rtl_reset_work(tp);
+	rtl8169_missed_msi_start(tp);
 
 	phy_start(tp->phydev);
 }
@@ -4885,7 +5126,7 @@ static void rtl8169_netpoll(struct net_device *dev)
 {
 	struct rtl8169_private *tp = netdev_priv(dev);
 
-	rtl8169_interrupt(tp->irq, tp);
+	rtl8169_interrupt_common(tp, false);
 }
 #endif
 
@@ -5092,6 +5333,9 @@ static void rtl_remove_one(struct pci_dev *pdev)
 {
 	struct rtl8169_private *tp = pci_get_drvdata(pdev);
 
+	set_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags);
+	rtl8169_missed_msi_stop(tp);
+
 	if (pci_dev_run_wake(pdev))
 		pm_runtime_get_noresume(&pdev->dev);
 
@@ -5525,13 +5769,14 @@ static int rtl_init_one(struct pci_dev *pdev, const struct pci_device_id *ent)
 	tp->irq = pci_irq_vector(pdev, 0);
 
 	INIT_WORK(&tp->wk.work, rtl_task);
+	INIT_DELAYED_WORK(&tp->missed_msi_work, rtl8169_missed_msi_work);
 	disable_work(&tp->wk.work);
 
 	rtl_init_mac_address(tp);
 
 	dev->ethtool_ops = &rtl8169_ethtool_ops;
 
-	netif_napi_add(dev, &tp->napi, rtl8169_poll);
+	netif_napi_add_weight(dev, &tp->napi, rtl8169_poll, 256);
 
 	dev->hw_features = NETIF_F_IP_CSUM | NETIF_F_RXCSUM |
 			   NETIF_F_HW_VLAN_CTAG_TX | NETIF_F_HW_VLAN_CTAG_RX;
-- 
2.43.0

