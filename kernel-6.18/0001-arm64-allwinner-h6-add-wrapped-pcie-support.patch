 drivers/pci/controller/dwc/Makefile           |   1 +
 .../pci/controller/dwc/pcie-designware-host.c |  23 +-
 .../pci/controller/dwc/pcie-sunxi-wrapped.c   | 561 ++++++++++++++++++
