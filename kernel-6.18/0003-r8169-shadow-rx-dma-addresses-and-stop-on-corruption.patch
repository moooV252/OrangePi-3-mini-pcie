From 222b53e58f712381bcb7fcdf76b5695e5bd5b1c7 Mon Sep 17 00:00:00 2001
From: Orange Pi 3 port <port@localhost>
Date: Sun, 23 Aug 2026 12:53:23 +0900
Subject: [PATCH 3/8] r8169: shadow RX DMA addresses and stop DMA on descriptor
 corruption

---
 drivers/net/ethernet/realtek/r8169_main.c | 35 +++++++++++++++++------
 1 file changed, 27 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index d407b031cc2a..d869835fe87f 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -711,6 +711,7 @@ struct rtl8169_private {
 	dma_addr_t TxPhyAddr;
 	dma_addr_t RxPhyAddr;
 	struct page *Rx_databuff[NUM_RX_DESC];	/* Rx data buffers */
+	dma_addr_t Rx_dma[NUM_RX_DESC];	/* Stable DMA addresses for Rx data */
 	struct ring_info tx_skb[NUM_TX_DESC];	/* Tx data buffers */
 	u16 cp_cmd;
 	u16 tx_lpi_timer;
@@ -3981,7 +3982,8 @@ static void rtl8169_mark_to_asic(struct RxDesc *desc)
 }
 
 static struct page *rtl8169_alloc_rx_data(struct rtl8169_private *tp,
-					  struct RxDesc *desc)
+					  struct RxDesc *desc,
+					  dma_addr_t *rx_dma)
 {
 	struct device *d = tp_to_dev(tp);
 	int node = dev_to_node(d);
@@ -3999,6 +4001,7 @@ static struct page *rtl8169_alloc_rx_data(struct rtl8169_private *tp,
 		return NULL;
 	}
 
+	*rx_dma = mapping;
 	desc->addr = cpu_to_le64(mapping);
 	rtl8169_mark_to_asic(desc);
 
@@ -4011,12 +4014,13 @@ static void rtl8169_rx_clear(struct rtl8169_private *tp)
 
 	for (i = 0; i < NUM_RX_DESC && tp->Rx_databuff[i]; i++) {
 		dma_unmap_page(tp_to_dev(tp),
-			       le64_to_cpu(tp->RxDescArray[i].addr),
+			       tp->Rx_dma[i],
 			       R8169_RX_BUF_SIZE, DMA_FROM_DEVICE);
 		__free_pages(tp->Rx_databuff[i], get_order(R8169_RX_BUF_SIZE));
 		tp->Rx_databuff[i] = NULL;
 		tp->RxDescArray[i].addr = 0;
 		tp->RxDescArray[i].opts1 = 0;
+		tp->Rx_dma[i] = 0;
 	}
 }
 
@@ -4027,7 +4031,8 @@ static int rtl8169_rx_fill(struct rtl8169_private *tp)
 	for (i = 0; i < NUM_RX_DESC; i++) {
 		struct page *data;
 
-		data = rtl8169_alloc_rx_data(tp, tp->RxDescArray + i);
+		data = rtl8169_alloc_rx_data(tp, tp->RxDescArray + i,
+					     tp->Rx_dma + i);
 		if (!data) {
 			rtl8169_rx_clear(tp);
 			return -ENOMEM;
@@ -4613,6 +4618,18 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 		 */
 		dma_rmb();
 
+		addr = tp->Rx_dma[entry];
+		if (unlikely(le64_to_cpu(desc->addr) != addr)) {
+			netdev_err(dev,
+				   "Rx descriptor %u DMA address was overwritten; stopping DMA\n",
+				   entry);
+			RTL_W8(tp, ChipCmd, RTL_R8(tp, ChipCmd) &
+					       ~(CmdTxEnb | CmdRxEnb));
+			netif_stop_queue(dev);
+			netif_carrier_off(dev);
+			break;
+		}
+
 		if (unlikely(status & RxRES)) {
 			if (net_ratelimit())
 				netdev_warn(dev, "Rx ERROR. status = %08x\n",
@@ -4623,10 +4640,12 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 			if (status & RxCRC)
 				dev->stats.rx_crc_errors++;
 
-			if (!(dev->features & NETIF_F_RXALL))
-				goto release_descriptor;
-			else if (status & RxRWT || !(status & (RxRUNT | RxCRC)))
-				goto release_descriptor;
+			netdev_err(dev, "invalid RX completion; stopping DMA\n");
+			RTL_W8(tp, ChipCmd, RTL_R8(tp, ChipCmd) &
+					       ~(CmdTxEnb | CmdRxEnb));
+			netif_stop_queue(dev);
+			netif_carrier_off(dev);
+			break;
 		}
 
 		pkt_size = status & GENMASK(13, 0);
@@ -4648,7 +4667,6 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 			goto release_descriptor;
 		}
 
-		addr = le64_to_cpu(desc->addr);
 		rx_buf = page_address(tp->Rx_databuff[entry]);
 
 		dma_sync_single_for_cpu(d, addr, pkt_size, DMA_FROM_DEVICE);
@@ -4670,6 +4688,7 @@ static int rtl_rx(struct net_device *dev, struct rtl8169_private *tp, int budget
 
 		dev_sw_netstats_rx_add(dev, pkt_size);
 release_descriptor:
+		desc->addr = cpu_to_le64(tp->Rx_dma[entry]);
 		rtl8169_mark_to_asic(desc);
 	}
 
-- 
2.43.0

