From 71d553e05a9ed983331e50f5ff35eec17b81c366 Mon Sep 17 00:00:00 2001
From: Orange Pi 3 port <port@localhost>
Date: Sun, 23 Aug 2026 12:53:24 +0900
Subject: [PATCH 4/7] r8169: disable endpoint PCIe L0s/L1 link states

---
 drivers/net/ethernet/realtek/r8169_main.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index d869835fe87f..245072ef0529 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -5471,7 +5471,16 @@ static int rtl_init_one(struct pci_dev *pdev, const struct pci_device_id *ent)
 		dev_info(&pdev->dev, "System vendor flags ASPM as safe\n");
 		rc = 0;
 	} else {
-		rc = pci_disable_link_state(pdev, PCIE_LINK_STATE_L1);
+		u16 lnkctl;
+
+		rc = pci_disable_link_state(pdev, PCIE_LINK_STATE_L1 |
+						   PCIE_LINK_STATE_L0S);
+		if (!rc) {
+			pcie_capability_read_word(pdev, PCI_EXP_LNKCTL, &lnkctl);
+			dev_info(&pdev->dev,
+				 "Orange Pi 3 PCIe workaround: ASPM L0s/L1 disabled (endpoint LnkCtl=%#06x)\n",
+				 lnkctl);
+		}
 	}
 	tp->aspm_manageable = !rc;
 
