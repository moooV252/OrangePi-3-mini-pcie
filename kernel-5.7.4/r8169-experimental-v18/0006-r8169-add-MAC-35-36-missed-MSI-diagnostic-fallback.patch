From c92d1e81e7becfffb1fcebf0cf0c8ff3122ddd2b Mon Sep 17 00:00:00 2001
From: Orange Pi diagnostics <diagnostics@localhost>
Date: Tue, 18 Aug 2026 03:39:38 +0900
Subject: [PATCH] r8169: add MAC 35/36 missed-MSI diagnostic fallback

---
 drivers/net/ethernet/realtek/r8169_main.c | 345 +++++++++++++++++++++-
 1 file changed, 335 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index df134b2..7029af0 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -75,6 +75,9 @@
 #define R8169_TX_RING_BYTES	(NUM_TX_DESC * sizeof(struct TxDesc))
 #define R8169_RX_RING_BYTES	(NUM_RX_DESC * sizeof(struct RxDesc))
 
+#define RTL8169_MISSED_MSI_POLL_MS	10
+#define RTL8169_MISSED_MSI_CREDIT_MS	100
+
 #define RTL_CFG_NO_GBIT	1
 
 /* write/read MMIO register */
@@ -585,6 +588,18 @@ enum rtl_flag {
 	RTL_FLAG_MAX
 };
 
+enum rtl_missed_msi_flag {
+	RTL_MISSED_MSI_ENABLED = 0,
+	RTL_MISSED_MSI_PM_HELD,
+	RTL_MISSED_MSI_DEAD,
+	RTL_MISSED_MSI_QUIESCED,
+	RTL_MISSED_MSI_ARM_LOGGED,
+	RTL_MISSED_MSI_FIRST_HIT_LOGGED,
+	RTL_MISSED_MSI_SUMMARY_LOGGED,
+	RTL_MISSED_MSI_ACK_CREDIT,
+	RTL_MISSED_MSI_FLAG_MAX
+};
+
 struct rtl8169_stats {
 	u64			packets;
 	u64			bytes;
@@ -616,6 +631,14 @@ struct rtl8169_private {
 	u32 irq_mask;
 	struct clk *clk;
 	unsigned long dma_corrupt;	/* Sticky diagnostic stop bit */
+	unsigned long missed_msi_flags;
+	spinlock_t missed_msi_napi_lock;
+	struct delayed_work missed_msi_work;
+	u32 missed_msi_polls;
+	u32 missed_msi_hits;
+	u32 missed_msi_first_status;
+	u32 missed_msi_credit_irqs;
+	unsigned long missed_msi_credit_deadline;
 	unsigned long diag_queue_state;
 	u32 diag_cur_tx;
 	u32 diag_dirty_tx;
@@ -647,6 +670,8 @@ struct rtl8169_private {
 	u32 ocp_base;
 };
 
+static void rtl8169_missed_msi_fault_stop(struct rtl8169_private *tp);
+
 typedef void (*rtl_generic_fct)(struct rtl8169_private *tp);
 
 MODULE_AUTHOR("Realtek and the Linux r8169 crew <netdev@vger.kernel.org>");
@@ -4042,6 +4067,7 @@ static bool rtl8169_dma_corruption_stop(struct rtl8169_private *tp)
 
 	if (test_and_set_bit(0, &tp->dma_corrupt))
 		return false;
+	rtl8169_missed_msi_fault_stop(tp);
 
 	tp->diag_queue_state = READ_ONCE(txq->state);
 	tp->diag_cur_tx = READ_ONCE(tp->cur_tx);
@@ -4804,14 +4830,33 @@ release_descriptor:
 	return count;
 }
 
-static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
+static bool rtl8169_missed_msi_supported(struct rtl8169_private *tp)
 {
-	struct rtl8169_private *tp = dev_instance;
-	u32 status = rtl_get_events(tp);
+	return tp->mac_version == RTL_GIGA_MAC_VER_35 ||
+	       tp->mac_version == RTL_GIGA_MAC_VER_36;
+}
+
+static void rtl8169_napi_irq_enable(struct rtl8169_private *tp)
+{
+	unsigned long flags;
+
+	if (!rtl8169_missed_msi_supported(tp)) {
+		rtl_irq_enable(tp);
+		return;
+	}
+
+	spin_lock_irqsave(&tp->missed_msi_napi_lock, flags);
+	rtl_irq_enable(tp);
+	spin_unlock_irqrestore(&tp->missed_msi_napi_lock, flags);
+}
 
-	if (!tp->irq_enabled || (status & 0xffff) == 0xffff ||
+static bool rtl8169_handle_events(struct rtl8169_private *tp, u32 status,
+				  bool irq_context)
+{
+	if (unlikely(test_bit(0, &tp->dma_corrupt)) || !tp->irq_enabled ||
+	    (status & 0xffff) == 0xffff ||
 	    !(status & tp->irq_mask))
-		return IRQ_NONE;
+		return false;
 
 	if (unlikely(status & SYSErr)) {
 		rtl8169_pcierr_interrupt(tp->dev);
@@ -4828,11 +4873,272 @@ static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
 	}
 
 	rtl_irq_disable(tp);
-	napi_schedule_irqoff(&tp->napi);
+	if (irq_context) {
+		napi_schedule_irqoff(&tp->napi);
+		rtl_ack_events(tp, status);
+	} else {
+		/* Process context must not let NAPI re-enable before the W1C. */
+		rtl_ack_events(tp, status);
+		napi_schedule(&tp->napi);
+	}
+	return true;
 out:
 	rtl_ack_events(tp, status);
 
-	return IRQ_HANDLED;
+	return true;
+}
+
+static irqreturn_t rtl8169_interrupt_common(struct rtl8169_private *tp,
+					     bool consume_credit)
+{
+	u32 status = rtl_get_events(tp);
+	bool credit = false;
+
+	if (consume_credit) {
+		credit = test_and_clear_bit(RTL_MISSED_MSI_ACK_CREDIT,
+					    &tp->missed_msi_flags);
+		if (credit)
+			smp_mb__after_atomic();
+	}
+
+	if (rtl8169_handle_events(tp, status, true))
+		return IRQ_HANDLED;
+
+	if (credit && status == 0 && rtl8169_missed_msi_supported(tp) &&
+	    tp->pci_dev->msi_enabled && !tp->pci_dev->msix_enabled &&
+	    test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags) &&
+	    !test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) &&
+	    !test_bit(0, &tp->dma_corrupt) &&
+	    time_before_eq(jiffies, READ_ONCE(tp->missed_msi_credit_deadline))) {
+		if (tp->missed_msi_credit_irqs != ~0U)
+			tp->missed_msi_credit_irqs++;
+		return IRQ_HANDLED;
+	}
+
+	return IRQ_NONE;
+}
+
+static irqreturn_t rtl8169_interrupt(int irq, void *dev_instance)
+{
+	return rtl8169_interrupt_common(dev_instance, true);
+}
+
+static void rtl8169_missed_msi_pm_put(struct rtl8169_private *tp)
+{
+	if (test_and_clear_bit(RTL_MISSED_MSI_PM_HELD,
+			       &tp->missed_msi_flags))
+		pm_runtime_put_noidle(&tp->pci_dev->dev);
+}
+
+static bool rtl8169_missed_msi_can_run(struct rtl8169_private *tp)
+{
+	return test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags) &&
+	       !test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) &&
+	       !test_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags) &&
+	       !test_bit(0, &tp->dma_corrupt) && netif_running(tp->dev) &&
+	       tp->pci_dev->msi_enabled && !tp->pci_dev->msix_enabled &&
+	       pm_runtime_active(&tp->pci_dev->dev) &&
+	       test_bit(RTL_FLAG_TASK_ENABLED, tp->wk.flags) &&
+	       tp->TxDescArray && tp->RxDescArray;
+}
+
+static void rtl8169_missed_msi_fault_stop(struct rtl8169_private *tp)
+{
+	set_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags);
+	set_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	if (cancel_delayed_work(&tp->missed_msi_work))
+		rtl8169_missed_msi_pm_put(tp);
+}
+
+static void rtl8169_missed_msi_work(struct work_struct *work)
+{
+	struct rtl8169_private *tp = container_of(to_delayed_work(work),
+						 struct rtl8169_private,
+						 missed_msi_work);
+	int irq = pci_irq_vector(tp->pci_dev, 0);
+	unsigned long flags;
+	u32 status;
+	bool first_hit = false;
+	bool handled;
+	bool rearm;
+
+	if (!test_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags)) {
+		rtl8169_missed_msi_pm_put(tp);
+		return;
+	}
+
+	rtl_lock_work(tp);
+	if (irq < 0 || !rtl8169_missed_msi_can_run(tp))
+		goto out_stop;
+
+	/*
+	 * The MMIO status/ack path is shared with the real MSI handler.
+	 * Serialize against that handler while polling from process context.
+	 */
+	disable_irq(irq);
+	if (!rtl8169_missed_msi_can_run(tp))
+		goto out_enable_irq;
+
+	/* Serialize with the tail of an already-running NAPI completion. */
+	spin_lock_irqsave(&tp->missed_msi_napi_lock, flags);
+	if (!rtl8169_missed_msi_can_run(tp) || !tp->irq_enabled) {
+		spin_unlock_irqrestore(&tp->missed_msi_napi_lock, flags);
+		goto out_enable_irq;
+	}
+
+	if (tp->missed_msi_polls != ~0U)
+		tp->missed_msi_polls++;
+	status = rtl_get_events(tp);
+	handled = rtl8169_handle_events(tp, status, false);
+	spin_unlock_irqrestore(&tp->missed_msi_napi_lock, flags);
+	if (handled) {
+		if (!test_and_set_bit(RTL_MISSED_MSI_FIRST_HIT_LOGGED,
+				      &tp->missed_msi_flags)) {
+			tp->missed_msi_first_status = status;
+			first_hit = true;
+		}
+		if (tp->missed_msi_hits != ~0U)
+			tp->missed_msi_hits++;
+		if (rtl8169_missed_msi_can_run(tp)) {
+			WRITE_ONCE(tp->missed_msi_credit_deadline,
+				   jiffies + msecs_to_jiffies(
+					   RTL8169_MISSED_MSI_CREDIT_MS));
+			smp_wmb();
+			set_bit(RTL_MISSED_MSI_ACK_CREDIT,
+				&tp->missed_msi_flags);
+			if (!rtl8169_missed_msi_can_run(tp))
+				clear_bit(RTL_MISSED_MSI_ACK_CREDIT,
+					  &tp->missed_msi_flags);
+		}
+	}
+
+out_enable_irq:
+	enable_irq(irq);
+	if (first_hit)
+		netdev_warn(tp->dev,
+			    "v18 missed-MSI fallback first hit: status=%08x masked=%08x polls=%u hits=%u irq=%d cur_tx=%u dirty_tx=%u\n",
+			    status, status & tp->irq_mask, tp->missed_msi_polls,
+			    tp->missed_msi_hits, irq, tp->cur_tx, tp->dirty_tx);
+
+	rearm = rtl8169_missed_msi_can_run(tp);
+	if (rearm && schedule_delayed_work(&tp->missed_msi_work,
+					   msecs_to_jiffies(RTL8169_MISSED_MSI_POLL_MS))) {
+		rtl_unlock_work(tp);
+		return;
+	}
+	if (rearm)
+		netdev_err(tp->dev,
+			   "v18 missed-MSI fallback failed to rearm; left disabled\n");
+
+out_stop:
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	rtl8169_missed_msi_pm_put(tp);
+	rtl_unlock_work(tp);
+}
+
+static void rtl8169_missed_msi_start(struct rtl8169_private *tp,
+				     bool new_session)
+{
+	int irq;
+
+	if (new_session) {
+		if (test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) ||
+		    test_bit(0, &tp->dma_corrupt))
+			return;
+		clear_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags);
+		clear_bit(RTL_MISSED_MSI_ARM_LOGGED, &tp->missed_msi_flags);
+		clear_bit(RTL_MISSED_MSI_FIRST_HIT_LOGGED,
+			  &tp->missed_msi_flags);
+		clear_bit(RTL_MISSED_MSI_SUMMARY_LOGGED,
+			  &tp->missed_msi_flags);
+		clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+		tp->missed_msi_polls = 0;
+		tp->missed_msi_hits = 0;
+		tp->missed_msi_first_status = 0;
+		tp->missed_msi_credit_irqs = 0;
+		tp->missed_msi_credit_deadline = 0;
+	}
+
+	irq = pci_irq_vector(tp->pci_dev, 0);
+	if (!rtl8169_missed_msi_supported(tp) ||
+	    !tp->pci_dev->msi_enabled ||
+	    tp->pci_dev->msix_enabled ||
+	    !pm_runtime_active(&tp->pci_dev->dev) ||
+	    irq < 0 ||
+	    test_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags) ||
+	    test_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags) ||
+	    test_bit(RTL_MISSED_MSI_PM_HELD, &tp->missed_msi_flags) ||
+	    test_bit(0, &tp->dma_corrupt) ||
+	    !test_bit(RTL_FLAG_TASK_ENABLED, tp->wk.flags) ||
+	    !tp->TxDescArray || !tp->RxDescArray ||
+	    test_and_set_bit(RTL_MISSED_MSI_ENABLED,
+			     &tp->missed_msi_flags))
+		return;
+
+	/* Close/suspend may have raced the initial gate before setting QUIESCED. */
+	smp_mb__after_atomic();
+	if (!rtl8169_missed_msi_can_run(tp)) {
+		clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+		return;
+	}
+
+	pm_runtime_get_noresume(&tp->pci_dev->dev);
+	set_bit(RTL_MISSED_MSI_PM_HELD, &tp->missed_msi_flags);
+	if (!rtl8169_missed_msi_can_run(tp)) {
+		clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+		rtl8169_missed_msi_pm_put(tp);
+		return;
+	}
+
+	if (!schedule_delayed_work(&tp->missed_msi_work,
+				   msecs_to_jiffies(RTL8169_MISSED_MSI_POLL_MS))) {
+		clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+		rtl8169_missed_msi_pm_put(tp);
+		netdev_err(tp->dev,
+			   "v18 missed-MSI fallback failed to arm; left disabled\n");
+	} else if (!rtl8169_missed_msi_can_run(tp)) {
+		clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+		cancel_delayed_work(&tp->missed_msi_work);
+		rtl8169_missed_msi_pm_put(tp);
+	} else if (!test_and_set_bit(RTL_MISSED_MSI_ARM_LOGGED,
+				     &tp->missed_msi_flags)) {
+		netdev_warn(tp->dev,
+			    "v18 missed-MSI fallback armed: period_ms=%u credit_ms=%u irq=%d\n",
+			    (unsigned int)RTL8169_MISSED_MSI_POLL_MS,
+			    (unsigned int)RTL8169_MISSED_MSI_CREDIT_MS, irq);
+	}
+}
+
+static void rtl8169_missed_msi_stop(struct rtl8169_private *tp)
+{
+	set_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	cancel_delayed_work_sync(&tp->missed_msi_work);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+
+	/*
+	 * A reset task may have passed its initial gate before QUIESCED was set.
+	 * Wait for that start attempt without holding the mutex across cancel.
+	 */
+	rtl_lock_work(tp);
+	set_bit(RTL_MISSED_MSI_QUIESCED, &tp->missed_msi_flags);
+	clear_bit(RTL_MISSED_MSI_ENABLED, &tp->missed_msi_flags);
+	rtl_unlock_work(tp);
+	cancel_delayed_work_sync(&tp->missed_msi_work);
+	clear_bit(RTL_MISSED_MSI_ACK_CREDIT, &tp->missed_msi_flags);
+	rtl8169_missed_msi_pm_put(tp);
+
+	if (tp->missed_msi_hits &&
+	    !test_and_set_bit(RTL_MISSED_MSI_SUMMARY_LOGGED,
+			      &tp->missed_msi_flags))
+		netdev_warn(tp->dev,
+			    "v18 missed-MSI fallback stopped: polls=%u hits=%u credited_irqs=%u first_status=%08x\n",
+			    tp->missed_msi_polls, tp->missed_msi_hits,
+			    tp->missed_msi_credit_irqs,
+			    tp->missed_msi_first_status);
 }
 
 static void rtl_task(struct work_struct *work)
@@ -4853,6 +5159,7 @@ static void rtl_task(struct work_struct *work)
 				       tp->wk.flags) &&
 		   !test_bit(0, &tp->dma_corrupt)) {
 		rtl_reset_work(tp);
+		rtl8169_missed_msi_start(tp, false);
 	}
 out_unlock:
 	rtl_unlock_work(tp);
@@ -4879,7 +5186,7 @@ static int rtl8169_poll(struct napi_struct *napi, int budget)
 	if (work_done < budget) {
 		napi_complete_done(napi, work_done);
 		if (likely(!test_bit(0, &tp->dma_corrupt)))
-			rtl_irq_enable(tp);
+			rtl8169_napi_irq_enable(tp);
 	}
 
 	return work_done;
@@ -4960,6 +5267,7 @@ static int rtl8169_close(struct net_device *dev)
 	struct pci_dev *pdev = tp->pci_dev;
 
 	pm_runtime_get_sync(&pdev->dev);
+	rtl8169_missed_msi_stop(tp);
 
 	/* Update counters before going down */
 	rtl8169_update_counters(tp);
@@ -4993,8 +5301,18 @@ static int rtl8169_close(struct net_device *dev)
 static void rtl8169_netpoll(struct net_device *dev)
 {
 	struct rtl8169_private *tp = netdev_priv(dev);
-
-	rtl8169_interrupt(pci_irq_vector(tp->pci_dev, 0), tp);
+	unsigned long flags;
+
+	/* A software netpoll invocation must not consume a real-MSI ACK credit. */
+	if (rtl8169_missed_msi_supported(tp)) {
+		/* Avoid recursive netconsole/panic polling from a locked printk. */
+		if (!spin_trylock_irqsave(&tp->missed_msi_napi_lock, flags))
+			return;
+		rtl8169_interrupt_common(tp, false);
+		spin_unlock_irqrestore(&tp->missed_msi_napi_lock, flags);
+	} else {
+		rtl8169_interrupt_common(tp, false);
+	}
 }
 #endif
 
@@ -5058,6 +5376,7 @@ static int rtl_open(struct net_device *dev)
 
 	phy_start(tp->phydev);
 	netif_start_queue(dev);
+	rtl8169_missed_msi_start(tp, true);
 
 	rtl_unlock_work(tp);
 
@@ -5137,6 +5456,7 @@ static void rtl8169_net_suspend(struct net_device *dev)
 	if (!netif_running(dev))
 		return;
 
+	rtl8169_missed_msi_stop(tp);
 	phy_stop(tp->phydev);
 	netif_device_detach(dev);
 
@@ -5178,6 +5498,7 @@ static void __rtl8169_resume(struct net_device *dev)
 	napi_enable(&tp->napi);
 	set_bit(RTL_FLAG_TASK_ENABLED, tp->wk.flags);
 	rtl_reset_work(tp);
+	rtl8169_missed_msi_start(tp, true);
 	rtl_unlock_work(tp);
 }
 
@@ -5313,6 +5634,8 @@ static void rtl_remove_one(struct pci_dev *pdev)
 {
 	struct net_device *dev = pci_get_drvdata(pdev);
 	struct rtl8169_private *tp = netdev_priv(dev);
+	set_bit(RTL_MISSED_MSI_DEAD, &tp->missed_msi_flags);
+	rtl8169_missed_msi_stop(tp);
 
 	if (r8168_check_dash(tp))
 		rtl8168_driver_stop(tp);
@@ -5727,7 +6050,9 @@ static int rtl_init_one(struct pci_dev *pdev, const struct pci_device_id *ent)
 	}
 
 	mutex_init(&tp->wk.mutex);
+	spin_lock_init(&tp->missed_msi_napi_lock);
 	INIT_WORK(&tp->wk.work, rtl_task);
+	INIT_DELAYED_WORK(&tp->missed_msi_work, rtl8169_missed_msi_work);
 	u64_stats_init(&tp->rx_stats.syncp);
 	u64_stats_init(&tp->tx_stats.syncp);
 
-- 
